// Test 19: Mixed branches splitting, compile validation, and compile members
import std::fmt;

fn i_print_if_printable_only<T>(val: T) -> void {
    if (typeof(val).printable()) {
        println(val);
    } else {
        @compile::throw new Error("not printable :" + typeof(val).as_str());
    }
}

fn i_print_if_printable_and_have_one_branch<T>(val: T) -> void {
    @compile {
        if (!typeof(val).printable()) {
            @compile::throw new Error("not printable :" + typeof(val).as_str());
        }
    }(val);
    println(val);
}

@compile :: {
    fn i_print_on_compile_time_only<T>(val: T) -> void {
        if (!typeof(val).printable()) {
            @compile::throw new Error("not printable :" + typeof(val).as_str());
        } else {
            @compile::print("Comptime print:", val);
        }
    }
}

fn main() -> int32 {
    i_print_if_printable_only(10);
    i_print_if_printable_and_have_one_branch(42);
    @compile::i_print_on_compile_time_only(100);
    println("MIXED BRANCHES AND COMPILE VALIDATION PASSED");
    return 0;
}
