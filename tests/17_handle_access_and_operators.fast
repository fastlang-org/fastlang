// Test 17: Legal Handle Access Operator (-.) and Iteration Handles
import std::fmt;
class CustomPrinter -> {
    public -> {
        str name = "FastPrinter";
    }
    handle -> {
        fn display() -> str {
            return "CustomPrinter:" + this.name;
        }
    }
}

class CounterSeq -> {
    public -> {
        int32 current = 0;
        int32 max_val = 3;
    }
    handle -> {
        fn is_done_iter() -> bool {
            return this.current >= this.max_val;
        }
        fn next() -> int32 {
            int32 val = this.current;
            this.current = this.current + 1;
            return val;
        }
    }
}

fn test_direct_handle_access() -> void {
    CustomPrinter p = new CustomPrinter();
    str text = p-.display();
    println("Handle display output: ", text); // EXPECT: Handle display output: CustomPrinter:FastPrinter
}

fn test_custom_iter_handle() -> void {
    CounterSeq seq = new CounterSeq();
    println("is_done before: ", seq-.is_done_iter()); // EXPECT: is_done before: false
    
    int32 v0 = seq-.next();
    int32 v1 = seq-.next();
    int32 v2 = seq-.next();
    println("Values: ", v0, ", ", v1, ", ", v2); // EXPECT: Values: 0, 1, 2
    println("is_done after: ", seq-.is_done_iter()); // EXPECT: is_done after: true
}

fn test_array_handle_access() -> void {
    int32 nums[] = [10, 20, 30];
    int32 first_elem = nums-.index_access(0);
    int32 second_elem = nums-.index_access(1);
    println("Array index_access: ", first_elem, ", ", second_elem); // EXPECT: Array index_access: 10, 20

     it := nums-.iter();
    println("Array it done before: ", it-.is_done_iter()); // EXPECT: Array it done before: false
    int32 n0 = it-.next();
    int32 n1 = it-.next();
    int32 n2 = it-.next();
    println("Array next values: ", n0, ", ", n1, ", ", n2); // EXPECT: Array next values: 10, 20, 30
    println("Array it done after: ", it-.is_done_iter()); // EXPECT: Array it done after: true
}

fn test_for_in_with_handles() -> void {
    CounterSeq seq = new CounterSeq();
    for c in seq {
        print(c, " ");
    }
    println("");
    // EXPECT: 0 1 2 
}

fn test_mut_ref_set_rebind() -> void {
    int32 a = 100;
    int32 b = 200;
    mutRef<int32> m = &a;
    println("Initial m: ", *m); // EXPECT: Initial m: 100
    set m = &b;
    println("Rebound m: ", *m); // EXPECT: Rebound m: 200
}

class AssignBox -> {
    public -> {
        int32 val = 0;
        str log = "";
    }
    handle -> {
        fn arrow_assign(v: int32) -> void {
            this.val = v;
            this.log = "arrow_assign:" + v;
            println("arrow_assign called");
        }
        fn arrow(v: int32) -> void {
            this.val = v;
            this.log = "arrow:" + v;
            println("arrow called");
        }
        fn equal_assign(v: int32) -> void {
            this.val = v;
            this.log = "equal_assign:" + v;
            println("equal_assign called");
        }
        fn equal(v: int32) -> void {
            this.val = v;
            this.log = "equal:" + v;
            println("equal called");
        }
    }
}

fn test_assign_handles_dispatch() -> void {
    AssignBox b1 -> 42;
    println("Decl arrow_assign: ", b1.log, " val=", b1.val); // EXPECT: Decl arrow_assign: arrow_assign:42 val=42

    b1 -> 100;
    println("Reassign arrow: ", b1.log, " val=", b1.val); // EXPECT: Reassign arrow: arrow:100 val=100

    AssignBox b2 = 50;
    println("Decl equal_assign: ", b2.log, " val=", b2.val); // EXPECT: Decl equal_assign: equal_assign:50 val=50

    b2 = 200;
    println("Reassign equal: ", b2.log, " val=", b2.val); // EXPECT: Reassign equal: equal:200 val=200
}

// ==============================================================================
// Comprehensive Access Handles Test: property_access, handle_access, namespace_access, arrow, fat_arrow
// ==============================================================================

blueprint InnerPayload = {
    int32 code;
    str message;
}

impl InnerPayload {
    fn get_code() -> int32 {
        return this.code;
    }
}

blueprint AccessOverload = {
    InnerPayload* ptr = undefined;
}

impl AccessOverload {
    handle -> {
        fn property_access(prop: MemberType) -> unknown* {
            return @compile::access(this.ptr, prop);
        }
        fn handle_access(prop: MemberType) -> unknown* {
            return @compile::access(this.ptr, prop);
        }
        fn namespace_access(prop: MemberType) -> unknown* {
            return @compile::access(this.ptr, prop);
        }
        fn arrow(prop: MemberType) -> unknown* {
            return @compile::access(this.ptr, prop);
        }
        fn fat_arrow(prop: MemberType) -> unknown* {
            return @compile::access(this.ptr, prop);
        }
    }
}

fn test_comprehensive_access_handles() -> void {
    InnerPayload payload = InnerPayload { code = 200, message = "Success" };
    AccessOverload proxy = AccessOverload { ptr = &payload };

    // 1. Property Access via (.)
    println("Property access (.) code: ", proxy.code); // EXPECT: Property access (.) code: 200
    println("Property access (.) msg: ", proxy.message); // EXPECT: Property access (.) msg: Success

    // 2. Handle Access via (-.)
    println("Handle access (-.) code: ", proxy-.code); // EXPECT: Handle access (-.) code: 200

    // 3. Namespace Access via (::)
    println("Namespace access (::) code: ", proxy::code); // EXPECT: Namespace access (::) code: 200

    // 4. Arrow Access via (->)
    println("Arrow access (->) code: ", proxy->code); // EXPECT: Arrow access (->) code: 200

    // 5. Fat Arrow Access via (=>)
    println("Fat arrow access (=>) code: ", proxy=>code); // EXPECT: Fat arrow access (=>) code: 200

    // Test writing through access handles:
    proxy->code = 300;
    println("After arrow write (->): ", proxy.code); // EXPECT: After arrow write (->): 300

    proxy=>code = 400;
    println("After fat_arrow write (=>): ", proxy.code); // EXPECT: After fat_arrow write (=>): 400

    proxy-.code = 500;
    println("After handle_access write (-.): ", proxy.code); // EXPECT: After handle_access write (-.): 500

    proxy::code = 600;
    println("After namespace_access write (::): ", proxy.code); // EXPECT: After namespace_access write (::): 600

    proxy.code = 700;
    println("After property_access write (.): ", proxy.code); // EXPECT: After property_access write (.): 700
    @compile::access(proxy.ptr, MemberType {
        name = "code",
        ty = int32,
    }) = 800;
    println("After handle_access write (@compile::access): ", proxy.code); // EXPECT: After handle_access write (@compile::access): 800

    // 6. Method Call via access handles:
    println("Method call via (.) get_code: ", proxy.get_code()); // EXPECT: Method call via (.) get_code: 800
    println("Method call via (->) get_code: ", proxy->get_code()); // EXPECT: Method call via (->) get_code: 800
}

fn add_nums(a: int32, b: int32) -> int32 {
    return a + b;
}

fn log_val(x: int32) -> void {
    println("log_val called with: ", x);
}

fn test_callable_ref_auto_return() -> void {
    mutRef<fn(int32, int32) -> int32> r_add = &add_nums;
    auto res1 = r_add(15, 25);
    println("mutRef add result: ", res1); // EXPECT: mutRef add result: 40

    auto res2 = r_add-.call(30, 70);
    println("mutRef add via -.call: ", res2); // EXPECT: mutRef add via -.call: 100

    ref<fn(int32, int32) -> int32> ref_add = &add_nums;
    auto res3 = ref_add(100, 200);
    println("ref add result: ", res3); // EXPECT: ref add result: 300

    mutRef<fn(int32) -> void> r_log = &log_val;
    r_log(999); // EXPECT: log_val called with: 999
}

class CustomException -> {
    public -> {
        str detail = "";
    }

    constructor -> {
        init(msg: str) -> {
            this.detail = msg;
        }
    }

    handle -> {
        fn $throw() -> CustomException {
            return this;
        }
        fn $display() -> str {
            return this.detail;
        }
    }
}

fn test_dollar_sigil_handles() -> void {
    CustomException ex = new CustomException("Custom error triggered");
    println("Exception detail: ", ex.detail); // EXPECT: Exception detail: Custom error triggered
    println("Exception display: ", ex); // EXPECT: Exception display: Custom error triggered
}

fn main() -> int32 {
    test_direct_handle_access();
    test_custom_iter_handle();
    test_array_handle_access();
    test_for_in_with_handles();
    test_mut_ref_set_rebind();
    test_assign_handles_dispatch();
    test_comprehensive_access_handles();
    test_callable_ref_auto_return();
    test_dollar_sigil_handles();
    return 0;
}



