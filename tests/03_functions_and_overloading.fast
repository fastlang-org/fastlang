// Comprehensive Suite 03: Functions, Overloading, Recursion, Default Parameters, and IIFE
import std;
import std::fmt;

fn add_vals(a: int32, b: int32) -> int32 {
    return a + b;
}

fn add_vals(a: float64, b: float64) -> float64 {
    return a + b;
}

fn compute(val: int32, factor := 2) -> int32 {
    return val * factor;
}
fn factorial(n: int32) -> int32 {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

fn test_overloading_and_defaults() -> void {
    int32 i_res = add_vals(10, 20);
    println("add_vals int: ", i_res); // EXPECT: add_vals int: 30

    float64 f_res = add_vals(1.5, 2.5);
    println("add_vals float: ", f_res); // EXPECT: add_vals float: 4

    int32 c1 = compute(10);
    int32 c2 = compute(10, 5);
    println("compute default: ", c1); // EXPECT: compute default: 20
    println("compute custom: ", c2);  // EXPECT: compute custom: 50
}

fn test_recursion() -> void {
    int32 fact5 = factorial(5);
    println("factorial 5: ", fact5); // EXPECT: factorial 5: 120
}

fn test_iife_and_anon() -> void {
    int32 sum = (fn(a: int32, b: int32) -> int32 {
        return a + b;
    })(15, 25);
    println("iife sum: ", sum); // EXPECT: iife sum: 40

    fn(x: int32) -> void {
        println("direct iife: ", x); // EXPECT: direct iife: 99
    }(99);
}

macro double_val = (val: int32) -> int32 {
    return val * 2;
};

macro decrement_val = (i: mutRef<int32>) -> {
    i -= 1;
};

macro break_it = () -> {
    break;
};

macro multi_stmt_micro = (count: mutRef<int32>) -> {
    count += 10;
    count += 5;
};

fn test_methods_and_micros() -> void {
    method<void> hello = () -> {
        println("hello from method");
    };
    hello(); // EXPECT: hello from method

    method add = (a: int32, b: int32) -> {
        return a + b;
    };
    int32 res = add(10, 20);
    println("method add: ", res); // EXPECT: method add: 30

    int32 doubled = double_val(25);
    println("micro double: ", doubled); // EXPECT: micro double: 50

    int32 val = 10;
    decrement_val(&val);
    println("micro decrement: ", val); // EXPECT: micro decrement: 9

    int32 iter = 0;
    while (true) -> {
        iter += 1;
        if (iter >= 3) {
            break_it();
        }
    }
    println("micro break: ", iter); // EXPECT: micro break: 3

    int32 counter = 0;
    multi_stmt_micro(&counter);
    println("micro multi: ", counter); // EXPECT: micro multi: 15
}

fn identity<T>(val: T) -> T {
    return val;
}
fn i_have_generic_in_my_call<T,S>(a: T, b: T) -> T {
    return a;
}
fn add_generic<T>(a: T, b: T) -> T {
    return a + b;
}

method pick_first<T, U>(a: T, _b: U) -> T {
    return a;
}

fn describe_val(_x: int32) -> str {
    return "concrete int32";
}

fn describe_val<T>(_x: T) -> str {
    return "generic catchall";
}

fn test_generics() -> void {
    int32 x = identity(100);
    println("identity int32: ", x); // EXPECT: identity int32: 100

    str s = identity("hello FastLang");
    println("identity str: ", s); // EXPECT: identity str: hello FastLang
    str res = i_have_generic_in_my_call<char>("hello", "FastLang");
    println("i_have_generic_in_my_call: ", res); // EXPECT: i_have_generic_in_my_call: hello
    
    int32 sum = add_generic(25, 75);
    println("add_generic int: ", sum); // EXPECT: add_generic int: 100

    float64 fsum = add_generic(1.5, 2.5);
    println("add_generic float: ", fsum); // EXPECT: add_generic float: 4

    int32 first = pick_first(42, "ignored");
    println("method pick_first: ", first); // EXPECT: method pick_first: 42

    lambda<(int32) -> int32> auto_pipe = |a| a;
    int32 gen_res = auto_pipe(888);
    println("generic lambda: ", gen_res); // EXPECT: generic lambda: 888

    str d_int = describe_val(555);
    println("overload int: ", d_int); // EXPECT: overload int: concrete int32

    str d_gen = describe_val("custom string");
    println("overload gen: ", d_gen); // EXPECT: overload gen: generic catchall
}

MathOps :: {
    fn add(a: int32, b: int32) -> int32 {
        return a + b;
    }

    NestedOps :: {
        fn mul(a: int32, b: int32) -> int32 {
            return a * b;
        }
    }
}

fn test_namespaces() -> void {
    int32 added = MathOps::add(20, 30);
    println("MathOps::add: ", added); // EXPECT: MathOps::add: 50

    int32 multiplied = MathOps::NestedOps::mul(6, 7);
    println("MathOps::NestedOps::mul: ", multiplied); // EXPECT: MathOps::NestedOps::mul: 42
}
fn try_send(b : bool) -> Result<int32> {
    if (b) {
        return Ok(10);
    }
    return Err("error");
}
fn test_result() -> void {
    Result<int32> res = try_send(true);
    println("result: ", res.get()); // EXPECT: result: 10

    res = try_send(false);
    println("result is_Err: ", res.is_Err()); // EXPECT: result is_Err: true
    try {
        println("result get: ", res.get()); 
    }catch(e) -> {
        println("result get: ", e.message); // EXPECT: result get: error
    }
    println("result get_or: ", res.get_or(100)); // EXPECT: result get_or: 100
}
fn add_implicit(a: int32, b: int32) -> int32 {
    a + b
}

fn choose_implicit(cond: bool) -> Result<int32> {
    if (cond) {
        Ok(42)
    } else {
        Err("failed")
    }
}

fn test_implicit_returns() -> void {
    int32 sum = add_implicit(15, 27);
    println("implicit sum: ", sum); // EXPECT: implicit sum: 42

    Result<int32> ok_res = choose_implicit(true);
    println("implicit ok: ", ok_res.get()); // EXPECT: implicit ok: 42

    Result<int32> err_res = choose_implicit(false);
    println("implicit err: ", err_res.is_Err()); // EXPECT: implicit err: true
}
fn test_isolated_blocks() -> void {
    int32 x = 10;
    {
        int32 y = 20;
        println("inner block y: ", y);
    }
    // println("outer block y: ", y); // This line would cause an error since y is out of scope
    println("outer block x: ", x); // EXPECT: outer block x: 10
}

fn alias_target_insert(s: str, t: str) -> str {
    return s + t;
}
fn alias_target_compute(a: int32, b: int32) -> int32 {
    return a + b;
}
fn alias_add using alias_target_insert;
fn alias_calc using alias_target_compute;

fn test_function_aliasing() -> void {
    str res = alias_add("hello, ", "world!");
    println("alias_add: ", res); // EXPECT: alias_add: hello, world!
    int32 num = alias_calc(15, 25);
    println("alias_calc: ", num); // EXPECT: alias_calc: 40
}

fn main() -> int32 {
    test_overloading_and_defaults();
    test_recursion();
    test_iife_and_anon();
    test_methods_and_micros();
    test_generics();
    test_namespaces();
    test_result();
    test_implicit_returns();
    test_isolated_blocks();
    test_function_aliasing();
    println("ALL 03_FUNCTIONS TESTS PASSED"); // EXPECT: ALL 03_FUNCTIONS TESTS PASSED
    return 0;
}

