// Comprehensive Suite 09: Scopes, State Machines, Labels, Goto, and Lifecycle Handles
import std::fmt;
import std::error;

machine CounterMachine -> {
    @init -> {
        this {
            int32 count = 0;
            int32 max_limit = 5;
        }
        int32 init_local = 100; // strictly local variable to @init
        goto -> @step1;
    } [1];

    @step1 -> {
        this.count = this.count + 1;
        if (this.count >= this.max_limit) {
            goto -> @finish;
        }
        goto -> @step1;
    } [2]; // limit set to 2 so it breaches and triggers error handler

    @step2 -> {
        this.count = this.count + 1;
        if (this.count >= this.max_limit) {
            goto -> @finish;
        }
        goto -> @step2;
    } [];

    @finish -> {
        leave;
    } [1];

    handle -> {
        fn call() -> int32 {
            goto -> @init;
        }
        fn leave() -> int32 {
            return this.count;
        }
        fn error(e: labelLimitError) -> int32 {
            println("Handled limit error on label: ", e.labelname);
            if (e.labelname == @step1) {
                goto -> @step2;
            } else {
                goto -> @finish;
            }
        }
    }
}

// State Machine testing label named after a foreign scope (@cpp)
machine ForeignLabelMachine -> {
    @start -> {
        goto -> @cpp;
    } [1];

    @cpp -> {
        println("Foreign scope label @cpp executed safely!");
        goto -> @done;
    } [1];

    @done -> {
        leave;
    } [1];

    handle -> {
        fn call() -> int32 {
            goto -> @start;
        }
        fn leave() -> int32 {
            return 1;
        }
    }
}

// State Machine with vertical sequential continue and implicit leave (from legacy test 86)
machine StepperMachine -> {
    @first -> {
        println("At @first");
        continue; // Must jump sequentially to @second
    } [1];

    @second -> {
        println("At @second");
        // No goto, break, or continue here -> must implicitly leave, NO fallthrough to @third!
    } [1];

    @third -> {
        println("ERROR: Should not reach @third!");
        goto -> @done;
    } [1];

    @done -> {
        leave;
    } [1];

    handle -> {
        fn call() -> int32 {
            goto -> @first;
        }
        fn leave() -> int32 {
            println("Implicit leave executed cleanly");
            return 42;
        }
    }
}

fn test_inplace_blocks() {
    // 1. Standalone in-place block
    {{
        int32 z = 100;
        println("Standalone in-place block: ", z);
    }};

    // 2. Case 1: Declaration initialized first, block executes after, x is in scope
    int32 x = 10 {{
        int32 y = 20;
        println("InPlace Case 1: ", x + y);
    }};
    println("InPlace Case 1 post: ", x);

    // 3. Case 2: Declaration uninitialized, block executes, then assignment
    int32 a = {{
        println("InPlace Case 2 block");
    }} 42;
    println("InPlace Case 2 post: ", a);

    // 4. Case 3: Block executes first, then declaration
    int32 {{
        println("InPlace Case 3 block");
    }} b = 55;
    println("InPlace Case 3 post: ", b);

    // 5. Case 4: Block executes first, then declaration
    int32 c {{
        println("InPlace Case 4 block");
    }} = 77;
    println("InPlace Case 4 post: ", c);

    // 6. Walrus in-place block
    w := 15 {{
        println("InPlace Walrus: ", w + 5);
    }};
    println("InPlace Walrus post: ", w);
}

fn main() -> int32 {
    test_inplace_blocks();
    int32 result = CounterMachine();
    println("Final Machine Count: ", result); // EXPECT: Final Machine Count: 5

    int32 foreign_res = ForeignLabelMachine();
    println("Foreign Label Machine Result: ", foreign_res); // EXPECT: Foreign Label Machine Result: 1

    int32 step_res = StepperMachine();
    println("Stepper Machine Result: ", step_res); // EXPECT: Stepper Machine Result: 42

    println("ALL 09_SCOPES TESTS PASSED"); // EXPECT: ALL 09_SCOPES TESTS PASSED
    return 0;
}


