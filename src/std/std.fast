// FastLang Standard Library: Core Prelude, Option & Base Types
import std::types;
import std::error;
using types;


public micro stop = ()-> {
    break;
}

public @compile :: {

    set typeof<T>(T) -> type;
    set sizeof<T>(T) -> uint32;
    set access<T>(T, MemberType) -> unknown*;
    set rand<T>() -> T;
    set rand<T>(T) -> T;
    set rand<T>(T, T) -> T;
    set rand<T>(T, T, T) -> T;
    set print<...T>(...T) -> void;
    set backend() -> Backend;
    set system() -> System;
    impl type<T> -> {
        set printable() -> bool;
        set as_str() -> str; 
        set is_pointer() -> bool;
        set is_array() -> bool;
       // set is_const() -> bool;
        set is_constant() -> bool;
        set is_undefined() -> bool;
        set is_runtime() -> bool;
        set is_comptime() -> bool;
        set has_handle(char[]) -> bool;
        set has_handle(type) -> bool;
        set has_handle(char[], type) -> bool;
        set has_method(char[]) -> bool;
        set has_method(type) -> bool;
        set has_method(char[], type) -> bool;
        set has_field(char[]) -> bool;
        set has_field(type) -> bool;
        set has_field(char[], type) -> bool;
        set is_primitive() -> bool;
        set throwable() -> bool;
        set shareable() -> bool;
        set copyable() -> bool;
        set default() -> T;
        set castable() -> bool;
        set castable_to(type) -> bool;
        set size() -> uint32;
    }
    impl type<&T> {
        set on_heap() -> bool;
        set on_stack() -> bool;
    }
    /*
    impl type<function> {
    set has_leave() -> bool;
    }
    */
    micro todo = (msg: str) -> {
        throw new Error("TODO: " + msg);
    }
    method cast<Target, Source>(val: Source) -> Target {
        if (!Source.is_primitive()) {
            throw new Error("casting not supported for non primitive types");
        }
        if (!Target.is_primitive()) {
            throw new Error("target type is not a primitive type");
        }
        if (Source.castable_to(Target)) {
            return val as Target;
        } else {
            throw new Error("Type " + Source.as_str() + " cannot be casted to " + Target.as_str());
        }
    }
    method rand_range<T>(size: int32) -> T[] {
        T arr[] = new T[size];
        for (int32 i = 0; i < size; i = i + 1) {
            arr[i] = rand<T>();
        }
        return arr;
    }

}
// @compile wrapper
public micro todo = (msg: str) -> void {
    @compile::todo(msg);
}

public method cast<Target, Source>(val: Source) -> Target {
    return @compile::cast<Target>(val);
}
public method rand_range<T>(size: int32) -> T[] {
    return @compile::rand_range<T>(size);
}
public method typeof<T>(val: T) -> type {
    return @compile::typeof(val);
}

public method sizeof<T>(val: T) -> uint32 {
    return @compile::sizeof(val);
}

public fn rand<T>() -> T {
    return @compile::rand<T>();
}

public fn rand<T>(max: T) -> T {
    return @compile::rand<T>(max);
}

public fn rand<T>(min: T, max: T) -> T {
    return @compile::rand<T>(min, max);
}

public fn rand<T>(min: T, max: T, step: T) -> T {
    return @compile::rand<T>(min, max, step);
}

public method deepCopy<T>(val: T) -> T {
    T temp = val-.copy();
    return temp;
}

using Option;
using Result;
using Backend;
using System;

public @sys :: {
    set exit(int32) -> void;
}