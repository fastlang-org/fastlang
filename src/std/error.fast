// FastLang Standard Library: Error Definition & Compile-time Throw Macro

public class Error -> {
    public -> {
        char message[];
        int32 code = 0;
        fn as_str() -> char[] {
            return "{ message: " + this.message + ", code: " + this.code + " }";
        }
    }

    constructor -> {
        init(err: Error) -> {
            this.message = err.message;
            this.code = err.code;
        }
        init(msg: char[]) -> {
            this.message = msg;
            this.code = 0;
        }
        init(code: int32) -> {
            this.message = "Error happened with code";
            this.code = code;
        }
        init(msg: char[], code: int32) -> {
            this.message = msg;
            this.code = code;
        }
    }
    
    handle -> {
        fn $throw() -> Error {
            return this;
        }
        fn display() -> char[] {
            return this.as_str();
        }
    }
}

public class IndexError extends Error -> {
    constructor -> {
        init(msg: char[]) -> {
            this.message = msg;
            this.code = 1;
        }
        init(msg: char[], code: int32) -> {
            this.message = msg;
            this.code = code;
        }
    }
}

public class TypeError extends Error -> {
    constructor -> {
        init(msg: char[]) -> {
            this.message = msg;
            this.code = 2;
        }
        init(msg: char[], code: int32) -> {
            this.message = msg;
            this.code = code;
        }
    }
}

public class KeyError extends Error -> {
    constructor -> {
        init(msg: char[]) -> {
            this.message = msg;
            this.code = 3;
        }
        init(msg: char[], code: int32) -> {
            this.message = msg;
            this.code = code;
        }
    }
}

public class labelLimitError extends Error -> {
    public -> {
        char labelname[];
        int32 limit = 0;
        int32 count = 0;
    }
    constructor -> {
        init(labelname: char[], limit: int32, count: int32) -> {
            this.labelname = labelname;
            this.limit = limit;
            this.count = count;
            this.message = "Label limit exceeded for '" + labelname + "'";
            this.code = 5;
        }
    }
    handle -> {
        fn $throw() -> labelLimitError {
            return this;
        }
    }
}

public @compile :: {
    macro $throw[e: Error] -> {
        throw e;
    }
}

