// FastLang Standard Library: Core Types & Aliases
import std::error;

public enum Option<T> -> {
    Some(T),
    None,
}
public enum Result<T> -> {
    Ok(T),
    Err(char[]),
}

public enum Backend -> {
    Cpp,
    Cranelift,
}

public enum System -> {
    Linux,
    Windows,
    MacOS,
}

public blueprint shared -> {
    int32 owners = 0;
}

public impl shared -> {
    handle -> {
        fn share() -> void {
            this.owners = this.owners + 1;
        }
    }
}

public blueprint MemberType -> {
    char name[];
    type ty;
}

public @compile :: {
    set access<T>(T, MemberType) -> unknown*;
    set access<T>(T, str) -> unknown*;
}

public blueprint pointer<T> -> {
    T* ptr = undefined;
    shared* counter = undefined;
    share counter if (this.ptr == other.ptr);
}
public blueprint ref<...T> -> {
    T* ptr = undefined;
    type inner = T;
}
public blueprint mutRef<...T> -> {
    T* ptr = undefined;
    shared* counter = undefined;
    type inner = T;
    type expect[] = [...T];
    share counter if (this.ptr == other.ptr);
}

public blueprint unique<T> -> {
    T* ptr = undefined;
    shared* counter = undefined;
    share counter if (this.ptr == other.ptr) {
        if (this.counter.owners > 1) {
            other.ptr = undefined;
        }
    }
}

public blueprint iterator<T> -> {
    T* ptr = undefined;
    usize total = 0;
    usize idx = 0;
}
        
public impl iterator<T> -> {
    handle -> {
        fn is_done_iter() -> bool {
            return this.idx >= this.total;
        }
        fn next() -> T {
            T val = this.ptr[this.idx];
            this.idx = this.idx + 1;
            return val;
        }
    }
}

public impl Option<T> -> {
    fn is_Some() -> bool {
        match this {
            Some(_) => return true,
            None => return false,
        }
        return false;
    }
    fn is_None() -> bool {
        match this {
            Some(_) => return false,
            None => return true,
        }
        return true;
    }
    fn get() -> T {
        match this {
            Some(val) => {
                return val;
            }
            None => {
                throw new Error("Option is None");
            }
        }
    }
    fn get_or(default_val := T.default()) -> T {
        match this {
            Some(val) => {
                return val;
            }
            None => {
                return default_val;
            }
        }
    }
    fn get_else(msg: method<() -> void>) -> T {
        match this {
            Some(val) => {
                return val;
            }
            None => {
                msg();
                return T.default();
            }
        }
    }
    fn as_str() -> str {
        match this {
            Some(val) => {
                return "Some(" + val + ")";
            }
            None => {
                return "None";
            }
        }
    }
    handle -> {
        fn default() -> Option<T> {
            return Option::None;
        }
        fn partial_equal(other: Option<T>) -> bool {
            match other {
                Some(val2) => {
                    match this {
                        Some(val1) => val1 == val2,
                        None => false,
                    }
                }
                None => {
                    match this {
                        Some(_) => false,
                        None => true,
                    }
                }
            }
        }
        fn not_equal(other: Option<T>) -> bool {
            return !(this == other);
        }
        fn display() -> str {
            match this {
                Some(val) => {
                    return "Some(" + val + ")";
                }
                None => {
                    return "None";
                }
            }
        }
        fn drop() -> void {
            match this {
                Some(val) => {
                    return;
                }
                None => {
                    return;
                }
            }
        }
    }
}
public impl Result<T> -> {
    fn is_Ok() -> bool {
        match this {
            Ok(_) => return true,
            Err(_) => return false,
        }
        return false;
    }
    fn is_Err() -> bool {
        match this {
            Ok(_) => return false,
            Err(_) => return true,
        }
        return true;
    }
    fn get() -> T {
        match this {
            Ok(val) => {
                return val;
            }
            Err(msg) => {
                throw new Error(msg);
            }
        }
        return T.default();
    }
    fn get_or(default_val := T.default()) -> T {
        match this {
            Ok(val) => {
                return val;
            }
            Err(_) => {
                return default_val;
            }
        }
    }
}
public impl ref<...T> -> {
    handle -> {
        fn property_access(prop: MemberType) -> unknown* {
            return @compile::access(this.ptr, prop);
        }
        fn call<...Args>(...args: ...Args) -> auto {
            return (*this.ptr)(...args);
        }
        fn display() -> char[] {
            if (!this.ptr) {
                return "None";
            }
            return "" + *this.ptr;
        }
        /*
        fn drop() -> void {
            // TODO: that is a bug (that don't run at compile time)
            @compile::throw new Error(" Attempting to delete a borrowed reference 'ref<T>'");
        }
        */
    }
}
public impl mutRef<...T> -> {
    fn claim() -> void {
        if (this.counter) {
            this.counter.owners = 1;
        }
    }
    handle -> {
        fn property_access(prop: MemberType) -> unknown* {
            return @compile::access(this.ptr, prop);
        }
        fn call<...Args>(...args: ...Args) -> auto {
            return (*this.ptr)(...args);
        }
        fn display() -> char[] {
            if (!this.ptr) {
                return "None";
            }
            return "" + *this.ptr;
        }
        fn add_reassign(val: T) -> void {
            *this.ptr += val;
        }
        fn sub_reassign(val: T) -> void {
            *this.ptr -= val;
        }
        fn mul_reassign(val: T) -> void {
            *this.ptr *= val;
        }
        fn div_reassign(val: T) -> void {
            *this.ptr /= val;
        }
        fn drop() -> void {
            if (!this.ptr) {
                return;
            }
            if (!this.counter) {
                return;
            }
            if (this.counter.owners <= 1) {
                del this.counter;
            }else {
                this.counter.owners = this.counter.owners - 1;
            }
        }
    }
}

public impl pointer<T> -> {
    handle -> {
        fn property_access(prop: MemberType) -> unknown* {
            return @compile::access(this.ptr, prop);
        }
        fn display() -> char[] {
            if (!this.ptr) {
                return "None";
            }
            return "" + *this.ptr;
        }
        fn drop() -> void {
            if (!this.ptr) {
                return;
            }
            if (!this.counter) {
                return;
            }
            if (this.counter.owners <= 1) {
                del this.counter;
            } else {
                this.counter.owners = this.counter.owners - 1;
            }
        }
    }
}
public impl char -> {
    handle -> {
        fn default() -> char {
            return ' ';
        }
        fn add(other: char[]) -> char[] {
            return [this, ...other];
        }
    }
    fn is_digit() -> bool {
        return this >= '0' && this <= '9';
    }

    fn is_alpha() -> bool {
        return (this >= 'a' && this <= 'z') || (this >= 'A' && this <= 'Z');
    }

    fn is_alphanumeric() -> bool {
        return (this >= 'a' && this <= 'z') || (this >= 'A' && this <= 'Z') || (this >= '0' && this <= '9');
    }

    fn is_whitespace() -> bool {
        return this == ' ' || this == '\t' || this == '\n' || this == '\r';
    }

    fn to_upper() -> char {
        if (this >= 'a' && this <= 'z') {
            return this - 'a' + 'A';
        }
        return this;
    }

    fn to_lower() -> char {
        if (this >= 'A' && this <= 'Z') {
            return this - 'A' + 'a';
        }
        return this;
    }

    fn to_int() -> int32 {
        if (this >= '0' && this <= '9') {
            return (this as int32) - ('0' as int32);
        }
        return this as int32;
    }

    fn to_hex() -> str {
        int32 v = this as int32;
        int32 hi = v / 16;
        int32 lo = v % 16;
        char h1 = if (hi < 10) (('0' as int32) + hi) as char else (('a' as int32) + (hi - 10)) as char;
        char h2 = if (lo < 10) (('0' as int32) + lo) as char else (('a' as int32) + (lo - 10)) as char;
        char res[] = new char[](2);
        res[0] = h1;
        res[1] = h2;
        return res;
    }

    fn to_bin() -> str {
        int32 v = this as int32;
        char res[] = new char[](8);
        int32 rem = v;
        for (int32 i = 7; i >= 0; i = i - 1) {
            res[i] = if ((rem % 2) == 1) '1' else '0';
            rem = rem / 2;
        }
        return res;
    }
}

public impl array<char> -> {
    handle -> {
        fn default() -> char[] {
            return ['\0'];
        }
        fn add(other: char[]) -> char[] {
            return [...this, ...other];
        }
        fn add(other: char) -> char[] {
            return [...this, other];
        }
        fn add(other: uchar[]) -> uchar[] {
            uchar res[] = new uchar[](this.len + other.len);
            for (usize i = 0; i < this.len; i = i + 1) {
                res[i] = this[i] as uchar;
            }
            for (usize j = 0; j < other.len; j = j + 1) {
                res[this.len + j] = other[j];
            }
            return res;
        }
        fn add(other: uchar) -> uchar[] {
            uchar res[] = new uchar[](this.len + 1);
            for (usize i = 0; i < this.len; i = i + 1) {
                res[i] = this[i] as uchar;
            }
            res[this.len] = other;
            return res;
        }
        fn add<Other>(other: Other) -> char[] {
            return [...this, ...other.as_str()];
        }
    }
    fn to_upper() -> char[] {
        char result[] = new char[](this.len);
        for (usize i = 0; i < this.len; i = i + 1) {
            result[i] = this[i].to_upper();
        }
        return result;
    }

    fn to_lower() -> char[] {
        char result[] = new char[](this.len);
        for (usize i = 0; i < this.len; i = i + 1) {
            result[i] = this[i].to_lower();
        }
        return result;
    }

    fn is_empty() -> bool {
        return this.len == 0;
    }

    fn first() -> Option<char> {
        if (this.len == 0) {
            return None;
        }
        return Some(this[0]);
    }

    fn last() -> Option<char> {
        if (this.len == 0) {
            return None;
        }
        return Some(this[this.len - 1]);
    }

    fn to_hex() -> str {
        if (this.len == 0) {
            return "";
        }
        char res[] = new char[](this.len * 2);
        for (usize i = 0; i < this.len; i = i + 1) {
            int32 v = this[i] as int32;
            int32 hi = v / 16;
            int32 lo = v % 16;
            res[i * 2] = if (hi < 10) (('0' as int32) + hi) as char else (('a' as int32) + (hi - 10)) as char;
            res[i * 2 + 1] = if (lo < 10) (('0' as int32) + lo) as char else (('a' as int32) + (lo - 10)) as char;
        }
        return res;
    }

    fn to_bin() -> str {
        if (this.len == 0) {
            return "";
        }
        char res[] = new char[](this.len * 8);
        for (usize i = 0; i < this.len; i = i + 1) {
            int32 rem = this[i] as int32;
            for (int32 b = 7; b >= 0; b = b - 1) {
                res[i * 8 + b] = if ((rem % 2) == 1) '1' else '0';
                rem = rem / 2;
            }
        }
        return res;
    }

    fn as_str() -> str {
        return this;
    }
}

public impl array<uchar> -> {
    handle -> {
        fn add(other: uchar[]) -> uchar[] {
            return [...this, ...other];
        }
        fn add(other: uchar) -> uchar[] {
            return [...this, other];
        }
        fn add(other: char[]) -> uchar[] {
            uchar res[] = new uchar[](this.len + other.len);
            for (usize i = 0; i < this.len; i = i + 1) {
                res[i] = this[i];
            }
            for (usize j = 0; j < other.len; j = j + 1) {
                res[this.len + j] = other[j] as uchar;
            }
            return res;
        }
        fn add(other: char) -> uchar[] {
            uchar res[] = new uchar[](this.len + 1);
            for (usize i = 0; i < this.len; i = i + 1) {
                res[i] = this[i];
            }
            res[this.len] = other as uchar;
            return res;
        }
    }
    fn is_empty() -> bool {
        return this.len == 0;
    }
}

public impl array<T> -> {
    handle -> { 
        fn iter() -> iterator<T> {
            iterator<T> it;
            it.ptr = this;
            it.total = this.len;
            it.idx = 0;
            return it;
        }
        fn index_access(idx: int32) -> T {
            @compile{
                //check index bounds in compile time
                if (!typeof(idx).runtime() && (idx < 0 || idx >= this.len)) {
                    throw new Error("Index out of bounds");
                }
            }(idx);
            if (idx < 0 || idx >= this.len) {
                throw new Error("Index out of bounds");
            }
            return this[idx];
        }
        fn partial_equal(other: array<T>) -> bool {
            if (this.len != other.len) {
                return false;
            }
            for (usize i = 0; i < this.len; i = i + 1) {
                if (this[i] != other[i]) {
                    return false;
                }
            }
            return true;
        }
        fn not_equal(other: array<T>) -> bool {
            if (this.len != other.len) {
                return true;
            }
            for (usize i = 0; i < this.len; i = i + 1) {
                if (this[i] != other[i]) {
                    return true;
                }
            }
            return false;
        }
        fn add(other: array<T>) -> array<T> {
            return [...this, ...other];
        }
        fn add(item: T) -> array<T> {
            return [...this, item];
        }
        fn cast<Target>() -> Target[] {
            @compile{
                if (!T.castable_to(Target)) {
                    throw new Error("Cannot cast array elements: source element type is not castable to target type [" + Target.as_str() + "]");
                }
            }();
            Target result[] = new Target[](this.len);
            for (usize i = 0; i < this.len; i = i + 1) {
                result[i] = this[i] as Target;
            }
            return result;
        }
        fn default() -> T[] {
            T arr[] = new T[](this.len || 0);
            for (usize i = 0; i < this.len; i = i + 1) {
                arr[i] = ();
            }
            return arr;
        }
        fn display() -> str {
            return this.as_str();
        }
    }
    fn as_str() -> str {
        str result = "[";
        for (usize i = 0; i < this.len; i = i + 1) {
            result += this[i].as_str();
            if (i < this.len - 1) {
                result += ", ";
            }
        }
        result += "]";
        return result;
    }
    fn is_empty() -> bool {
        return this.len == 0;
    }

    fn first() -> Option<T> {
        if (this.len == 0) {
            return None;
        }
        return Some(this[0]);
    }

    fn last() -> Option<T> {
        if (this.len == 0) {
            return None;
        }
        return Some(this[this.len - 1]);
    }
    fn contains(val: T) -> bool {
        for ele in this {
            if (ele == val) {
                return true;
            }
        }
         return false;
    }
    fn sort(compare: lambda<(T, T) -> int32>) -> void {
        for (usize i = 0; i < this.len - 1; i = i + 1) {
            for (usize j = 0; j < this.len - i - 1; j = j + 1) {
                if (compare(this[j], this[j + 1]) > 0) {
                    T temp = this[j];
                    this[j] = this[j + 1];
                    this[j + 1] = temp;
                }
            }
        }
    }
    fn reverse() -> void {
    usize len = this.len;
    usize half = len / 2;
    for (usize i = 0; i < half; i = i + 1) {
        usize j = len - i - 1;
        T temp = this[i];
        this[i] = this[j];
        this[j] = temp;
    }
    }
    fn map(transform: lambda<(T) -> T>) -> void {
        for (usize i = 0; i < this.len; i = i + 1) {
            this[i] = transform(this[i]);
        }
    }
    fn chain(other: T[]) -> T[] {
        return [...this, ...other];
    }
    fn slice(start: usize, end: usize) -> T[] {
        @compile {
            if (!typeof(start).runtime() && !typeof(end).runtime()) {
                if (start > end) {
                    throw new Error("start must be less than or equal to end");
                }
            }
        }(start, end);
        if (start > end || start > this.len || end > this.len) {
            throw new Error("Slice bounds out of range");
        }
        if (start == end) {
            return [];
        }
        usize new_len = end - start;
        T arr[] = new T[](new_len);
        for (usize i = 0; i < new_len; i = i + 1) {
            arr[i] = this[start + i];
        }
        return arr;
    }
}

