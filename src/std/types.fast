// FastLang Standard Library: Core Types & Aliases
import std::error;

public enum Option<T> -> {
    Some(T),
    None,
}
public enum Result<T> -> {
    Ok(T),
    Err(char[]),
}

public enum Backend -> {
    Cpp,
    Cranelift,
}

public enum System -> {
    Linux,
    Windows,
    MacOS,
}

public blueprint document -> {
    char content[];
    uchar ucontent[];
    char ext[] = "txt";
}

public impl document -> {
    fn get_content() -> str {
        return this.content;
    }
    fn set_content(c: str) -> void {
        this.content = c;
    }
    fn get_ucontent() -> uchar[] {
        return this.ucontent;
    }
    fn set_ucontent(u: uchar[]) -> void {
        this.ucontent = u;
    }
    fn as_str() -> str {
        return this.content;
    }
    fn as_ustr() -> uchar[] {
        return this.ucontent;
    }
    fn get_extension() -> str {
        return this.ext;
    }
    fn set_extension(e: str) -> void {
        this.ext = e;
    }
    fn len() -> usize {
        if (this.ucontent.len > 0) {
            return this.ucontent.len;
        }
        return this.content.len;
    }
    handle -> {
        fn display() -> str {
            return this.content;
        }
        fn extension() -> char[] {
            return this.ext;
        }
    }
}

public class Document extends document -> {
}

public class HtmlDocument extends document -> {
    public -> {
        fn render() -> str {
            return this.as_str();
        }
        fn render_u() -> uchar[] {
            return this.as_ustr();
        }
    }
    handle -> {
        fn display() -> str {
            return this.as_str();
        }
        fn extension() -> char[] {
            return this.ext;
        }
    }
}

public class JsonDocument extends document -> {
    public -> {
        fn as_str() -> str {
            return this.get_content();
        }
    }
    handle -> {
        fn display() -> str {
            return this.as_str();
        }
        fn extension() -> char[] {
            return this.ext;
        }
        fn index_access(key: str) -> str {
            str c = this.as_str();
            int32 c_len = c.len;
            int32 k_len = key.len;
            if (c_len == 0 || k_len == 0) {
                return "";
            }

            int32 match_idx = -1;
            for (int32 i = 0; i + k_len + 2 <= c_len; i = i + 1) {
                if (c[i] == '"') {
                    bool matched = true;
                    for (int32 k = 0; k < k_len; k = k + 1) {
                        if (c[i + 1 + k] != key[k]) {
                            matched = false;
                            break;
                        }
                    }
                    if (matched && c[i + 1 + k_len] == '"') {
                        match_idx = i + 2 + k_len;
                        break;
                    }
                }
            }

            if (match_idx == -1) {
                return "";
            }

            int32 pos = match_idx;
            while (pos < c_len) {
                char ch = c[pos];
                if (ch == ' ') { pos = pos + 1; }
                else if (ch == '\t') { pos = pos + 1; }
                else if (ch == '\r') { pos = pos + 1; }
                else if (ch == '\n') { pos = pos + 1; }
                else if (ch == ':') { pos = pos + 1; }
                else { break; }
            }

            if (pos >= c_len) {
                return "";
            }

            if (c[pos] == '"') {
                pos = pos + 1;
                int32 start = pos;
                while (pos < c_len && c[pos] != '"') {
                    pos = pos + 1;
                }
                int32 val_len = pos - start;
                char res[] = new char[](val_len);
                for (int32 j = 0; j < val_len; j = j + 1) {
                    res[j] = c[start + j];
                }
                return res;
            } else {
                int32 start = pos;
                while (pos < c_len) {
                    char ch = c[pos];
                    if (ch == ',') { break; }
                    if (ch == '}') { break; }
                    if (ch == ']') { break; }
                    if (ch == ' ') { break; }
                    if (ch == '\t') { break; }
                    if (ch == '\r') { break; }
                    if (ch == '\n') { break; }
                    pos = pos + 1;
                }
                int32 val_len = pos - start;
                char res[] = new char[](val_len);
                for (int32 j = 0; j < val_len; j = j + 1) {
                    res[j] = c[start + j];
                }
                return res;
            }
        }
    }
}

public enum DocumentType -> {
    Html(HtmlDocument),
    Json(JsonDocument),
    Safe(document),
    Raw(document),
}

public impl DocumentType -> {
    fn as_str() -> str {
        match this {
            Html(d) => return d.as_str(),
            Json(d) => return d.as_str(),
            Safe(d) => return d.as_str(),
            Raw(d) => return d.as_str(),
        }
        return "";
    }
    fn as_ustr() -> uchar[] {
        match this {
            Html(d) => return d.as_ustr(),
            Json(d) => return d.as_ustr(),
            Safe(d) => return d.as_ustr(),
            Raw(d) => return d.as_ustr(),
        }
        return u"";
    }
    fn extension() -> str {
        match this {
            Html(d) => return d.get_extension(),
            Json(d) => return d.get_extension(),
            Safe(d) => return d.get_extension(),
            Raw(d) => return d.get_extension(),
        }
        return "";
    }
}

public blueprint shared -> {
    int32 owners = 0;
}

public impl shared -> {
    handle -> {
        fn share() -> void {
            this.owners = this.owners + 1;
        }
    }
}

public blueprint MemberType -> {
    char name[];
    type ty;
}

public blueprint pointer<T> -> {
    T* ptr = undefined;
    shared* counter = undefined;
    share counter if (this.ptr == other.ptr);
}
public blueprint ref<...T> -> {
    T* ptr = undefined;
    type inner = T;
}
public blueprint mutRef<...T> -> {
    T* ptr = undefined;
    shared* counter = undefined;
    type inner = T;
    type expect[] = [...T];
    share counter if (this.ptr == other.ptr);
}

public blueprint iterator<T> -> {
    T* ptr = undefined;
    usize total = 0;
    usize idx = 0;
}
        
public impl iterator<T> -> {
    handle -> {
        fn is_done_iter() -> bool {
            return this.idx >= this.total;
        }
        fn next() -> T {
            T val = this.ptr[this.idx];
            this.idx = this.idx + 1;
            return val;
        }
    }
}

public define str = array<char>;
public define ustr = array<uchar>;
public impl Option<T> -> {
    fn is_Some() -> bool {
        match this {
            Some(_) => return true,
            None => return false,
        }
        return false;
    }
    fn is_None() -> bool {
        match this {
            Some(_) => return false,
            None => return true,
        }
        return true;
    }
    fn get() -> T {
        match this {
            Some(val) => {
                return val;
            }
            None => {
                throw new Error("Option is None");
            }
        }
    }
    fn get_or(default_val := T.default()) -> T {
        match this {
            Some(val) => {
                return val;
            }
            None => {
                return default_val;
            }
        }
    }
    fn get_else(msg: method<() -> void>) -> T {
        match this {
            Some(val) => {
                return val;
            }
            None => {
                msg();
                return T.default();
            }
        }
    }
    fn as_str() -> str {
        match this {
            Some(val) => {
                return "Some(" + val + ")";
            }
            None => {
                return "None";
            }
        }
    }
    handle -> {
        fn default() -> Option<T> {
            return Option::None;
        }
        fn partial_equal(other: Option<T>) -> bool {
            match other {
                Some(val2) => {
                    match this {
                        Some(val1) => val1 == val2,
                        None => false,
                    }
                }
                None => {
                    match this {
                        Some(_) => false,
                        None => true,
                    }
                }
            }
        }
        fn not_equal(other: Option<T>) -> bool {
            return !(this == other);
        }
        fn display() -> str {
            match this {
                Some(val) => {
                    return "Some(" + val + ")";
                }
                None => {
                    return "None";
                }
            }
        }
        fn drop() -> void {
            match this {
                Some(val) => {
                    return;
                }
                None => {
                    return;
                }
            }
        }
    }
}
public impl Result<T> -> {
    fn is_Ok() -> bool {
        match this {
            Ok(_) => return true,
            Err(_) => return false,
        }
        return false;
    }
    fn is_Err() -> bool {
        match this {
            Ok(_) => return false,
            Err(_) => return true,
        }
        return true;
    }
    fn get() -> T {
        match this {
            Ok(val) => {
                return val;
            }
            Err(msg) => {
                throw new Error(msg);
            }
        }
        return T.default();
    }
    fn get_or(default_val := T.default()) -> T {
        match this {
            Ok(val) => {
                return val;
            }
            Err(_) => {
                return default_val;
            }
        }
    }
}
public impl ref<...T> -> {
    handle -> {
        fn property_access(prop: MemberType) -> unknown* {
            return @compile::access(this.ptr, prop);
        }
        fn call<...Args>(...args: ...Args) -> auto {
            return (*this.ptr)(...args);
        }
        fn display() -> char[] {
            if (!this.ptr) {
                return "None";
            }
            return "" + *this.ptr;
        }
        /*
        fn drop() -> void {
            // TODO: that is a bug (that don't run at compile time)
            @compile::throw new Error(" Attempting to delete a borrowed reference 'ref<T>'");
        }
        */
    }
}
public impl mutRef<...T> -> {
    fn claim() -> void {
        if (this.counter) {
            this.counter.owners = 1;
        }
    }
    handle -> {
        fn property_access(prop: MemberType) -> unknown* {
            return @compile::access(this.ptr, prop);
        }
        fn call<...Args>(...args: ...Args) -> auto {
            return (*this.ptr)(...args);
        }
        fn display() -> char[] {
            if (!this.ptr) {
                return "None";
            }
            return "" + *this.ptr;
        }
        fn add_reassign(val: T) -> void {
            *this.ptr += val;
        }
        fn sub_reassign(val: T) -> void {
            *this.ptr -= val;
        }
        fn mul_reassign(val: T) -> void {
            *this.ptr *= val;
        }
        fn div_reassign(val: T) -> void {
            *this.ptr /= val;
        }
        fn drop() -> void {
            if (!this.ptr) {
                return;
            }
            if (!this.counter) {
                return;
            }
            if (this.counter.owners <= 1) {
                del this.counter;
            }else {
                this.counter.owners = this.counter.owners - 1;
            }
        }
    }
}

public impl pointer<T> -> {
    handle -> {
        fn property_access(prop: MemberType) -> unknown* {
            return @compile::access(this.ptr, prop);
        }
        fn display() -> char[] {
            if (!this.ptr) {
                return "None";
            }
            return "" + *this.ptr;
        }
        fn drop() -> void {
            if (!this.ptr) {
                return;
            }
            if (!this.counter) {
                return;
            }
            if (this.counter.owners <= 1) {
                del this.counter;
            } else {
                this.counter.owners = this.counter.owners - 1;
            }
        }
    }
}
public impl char -> {
    handle -> {
        fn default() -> char {
            return ' ';
        }
        fn add(other: char[]) -> char[] {
            return [this, ...other];
        }
    }
    fn is_digit() -> bool {
        return this >= '0' && this <= '9';
    }

    fn is_alpha() -> bool {
        return (this >= 'a' && this <= 'z') || (this >= 'A' && this <= 'Z');
    }

    fn is_alphanumeric() -> bool {
        return (this >= 'a' && this <= 'z') || (this >= 'A' && this <= 'Z') || (this >= '0' && this <= '9');
    }

    fn is_whitespace() -> bool {
        return this == ' ' || this == '\t' || this == '\n' || this == '\r';
    }

    fn to_upper() -> char {
        if (this >= 'a' && this <= 'z') {
            return this - 'a' + 'A';
        }
        return this;
    }

    fn to_lower() -> char {
        if (this >= 'A' && this <= 'Z') {
            return this - 'A' + 'a';
        }
        return this;
    }
}

public impl array<char> -> {
    handle -> {
        fn default() -> char[] {
            return ['\0'];
        }
        fn add(other: char[]) -> char[] {
            return [...this, ...other];
        }
        fn add(other: char) -> char[] {
            return [...this, other];
        }
        fn add(other: uchar[]) -> uchar[] {
            uchar res[] = new uchar[](this.len + other.len);
            for (usize i = 0; i < this.len; i = i + 1) {
                res[i] = this[i] as uchar;
            }
            for (usize j = 0; j < other.len; j = j + 1) {
                res[this.len + j] = other[j];
            }
            return res;
        }
        fn add(other: uchar) -> uchar[] {
            uchar res[] = new uchar[](this.len + 1);
            for (usize i = 0; i < this.len; i = i + 1) {
                res[i] = this[i] as uchar;
            }
            res[this.len] = other;
            return res;
        }
        fn add<Other>(other: Other) -> char[] {
            return [...this, ...other.as_str()];
        }
    }
    fn to_upper() -> char[] {
        char result[] = new char[](this.len);
        for (usize i = 0; i < this.len; i = i + 1) {
            result[i] = this[i].to_upper();
        }
        return result;
    }

    fn to_lower() -> char[] {
        char result[] = new char[](this.len);
        for (usize i = 0; i < this.len; i = i + 1) {
            result[i] = this[i].to_lower();
        }
        return result;
    }

    fn is_empty() -> bool {
        return this.len == 0;
    }

    fn first() -> Option<char> {
        if (this.len == 0) {
            return None;
        }
        return Some(this[0]);
    }

    fn last() -> Option<char> {
        if (this.len == 0) {
            return None;
        }
        return Some(this[this.len - 1]);
    }

    fn as_str() -> str {
        return this;
    }
}

public impl array<uchar> -> {
    handle -> {
        fn add(other: uchar[]) -> uchar[] {
            return [...this, ...other];
        }
        fn add(other: uchar) -> uchar[] {
            return [...this, other];
        }
        fn add(other: char[]) -> uchar[] {
            uchar res[] = new uchar[](this.len + other.len);
            for (usize i = 0; i < this.len; i = i + 1) {
                res[i] = this[i];
            }
            for (usize j = 0; j < other.len; j = j + 1) {
                res[this.len + j] = other[j] as uchar;
            }
            return res;
        }
        fn add(other: char) -> uchar[] {
            uchar res[] = new uchar[](this.len + 1);
            for (usize i = 0; i < this.len; i = i + 1) {
                res[i] = this[i];
            }
            res[this.len] = other as uchar;
            return res;
        }
    }
    fn is_empty() -> bool {
        return this.len == 0;
    }
}

public impl array<T> -> {
    handle -> { 
        fn iter() -> iterator<T> {
            iterator<T> it;
            it.ptr = this;
            it.total = this.len;
            it.idx = 0;
            return it;
        }
        fn index_access(idx: int32) -> T {
            @compile{
                //check index bounds in compile time
                if (!typeof(idx).runtime() && (idx < 0 || idx >= this.len)) {
                    throw new Error("Index out of bounds");
                }
            }(idx);
            if (idx < 0 || idx >= this.len) {
                throw new Error("Index out of bounds");
            }
            return this[idx];
        }
        fn partial_equal(other: array<T>) -> bool {
            if (this.len != other.len) {
                return false;
            }
            for (usize i = 0; i < this.len; i = i + 1) {
                if (this[i] != other[i]) {
                    return false;
                }
            }
            return true;
        }
        fn not_equal(other: array<T>) -> bool {
            if (this.len != other.len) {
                return true;
            }
            for (usize i = 0; i < this.len; i = i + 1) {
                if (this[i] != other[i]) {
                    return true;
                }
            }
            return false;
        }
        fn add(other: array<T>) -> array<T> {
            return [...this, ...other];
        }
        fn add(item: T) -> array<T> {
            return [...this, item];
        }
        fn cast<Target>() -> Target[] {
            @compile{
                if (!T.castable_to(Target)) {
                    throw new Error("Cannot cast array elements: source element type is not castable to target type [" + Target.as_str() + "]");
                }
            }();
            Target result[] = new Target[](this.len);
            for (usize i = 0; i < this.len; i = i + 1) {
                result[i] = this[i] as Target;
            }
            return result;
        }
        fn default() -> T[] {
            T arr[] = new T[](this.len || 0);
            for (usize i = 0; i < this.len; i = i + 1) {
                arr[i] = ();
            }
            return arr;
        }
        fn display() -> str {
            return this.as_str();
        }
    }
    fn as_str() -> str {
        str result = "[";
        for (usize i = 0; i < this.len; i = i + 1) {
            result += this[i].as_str();
            if (i < this.len - 1) {
                result += ", ";
            }
        }
        result += "]";
        return result;
    }
    fn is_empty() -> bool {
        return this.len == 0;
    }

    fn first() -> Option<T> {
        if (this.len == 0) {
            return None;
        }
        return Some(this[0]);
    }

    fn last() -> Option<T> {
        if (this.len == 0) {
            return None;
        }
        return Some(this[this.len - 1]);
    }
    fn contains(val: T) -> bool {
        for ele in this {
            if (ele == val) {
                return true;
            }
        }
         return false;
    }
    fn sort(compare: lambda<(T, T) -> int32>) -> void {
        for (usize i = 0; i < this.len - 1; i = i + 1) {
            for (usize j = 0; j < this.len - i - 1; j = j + 1) {
                if (compare(this[j], this[j + 1]) > 0) {
                    T temp = this[j];
                    this[j] = this[j + 1];
                    this[j + 1] = temp;
                }
            }
        }
    }
    fn reverse() -> void {
    usize len = this.len;
    usize half = len / 2;
    for (usize i = 0; i < half; i = i + 1) {
        usize j = len - i - 1;
        T temp = this[i];
        this[i] = this[j];
        this[j] = temp;
    }
    }
    fn map(transform: lambda<(T) -> T>) -> void {
        for (usize i = 0; i < this.len; i = i + 1) {
            this[i] = transform(this[i]);
        }
    }
    fn chain(other: T[]) -> T[] {
        return [...this, ...other];
    }
    fn slice(start: usize, end: usize) -> T[] {
        @compile {
            if (!typeof(start).runtime() && !typeof(end).runtime()) {
                if (start > end) {
                    throw new Error("start must be less than or equal to end");
                }
            }
        }(start, end);
        if (start > end || start > this.len || end > this.len) {
            throw new Error("Slice bounds out of range");
        }
        if (start == end) {
            return [];
        }
        usize new_len = end - start;
        T arr[] = new T[](new_len);
        for (usize i = 0; i < new_len; i = i + 1) {
            arr[i] = this[start + i];
        }
        return arr;
    }
}

