import @c "clib/math.h";

extern @c :: {
    fn fast_sqrt(x: float64) -> float64;
    fn fast_pow(base: float64, exp: float64) -> float64;
    fn fast_sin(x: float64) -> float64;
    fn fast_cos(x: float64) -> float64;
    fn fast_tan(x: float64) -> float64;
    fn fast_floor(x: float64) -> float64;
    fn fast_ceil(x: float64) -> float64;
}
public fn sqrt<T>(x: T) -> float64 {
    return fast_sqrt(x as float64);
}

public fn pow<T, U>(base: T, exp: U) -> float64 {
    return fast_pow(base as float64, exp as float64);
}

public fn sin<T>(x: T) -> float64 {
    return fast_sin(x as float64);
}

public fn cos<T>(x: T) -> float64 {
    return fast_cos(x as float64);
}

public fn tan<T>(x: T) -> float64 {
    return fast_tan(x as float64);
}

public fn square<T>(x: T) -> T {
    return x * x;
}

public fn abs<T>(x: T) -> T {
    if (x < 0) {
        return -x;
    }
    return x;
}

public fn floor<T>(x: T) -> float64 {
    return fast_floor(x as float64);
}

public fn ceil<T>(x: T) -> float64 {
    return fast_ceil(x as float64);
}
