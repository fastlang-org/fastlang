// Standard Library: Unified Collections (List, HashSet, HashMap)

public class node<T> -> {
    private -> {
        T value;
        Option<mutRef<node<T>>> next = None;
    }
    public -> {
        fn get_value() -> T {
            return this.value;
        }
        fn set_value(v: T) -> void {
            this.value = v;
        }
        fn get_next() -> Option<mutRef<node<T>>> {
            return this.next;
        }
        fn set_next(n: Option<mutRef<node<T>>>) -> void {
            this.next = n;
        }
        fn as_str() -> str {
            return "{ value: " + this.value + ", next: " + this.next.as_str() + " }";
        }
    }
    constructor -> {
        init(v: T) -> {
            this.value = v;
            this.next = None;
        }
    }
    handle -> {
        fn drop() -> void {
            if (this.next.is_Some()) {
                del this.next;
            }
        }
        fn display() -> char[] {
            return this.as_str();
        }
    }
}

public blueprint list_iter<T> -> {
    Option<mutRef<node<T>>> current = None;
}

public impl list_iter<T> -> {
    handle -> {
        fn is_done_iter() -> bool {
            return this.current.is_None();
        }
        fn next() -> T {
            mutRef<node<T>> c = this.current.get();
            T val = c.get_value();
            this.current = c.get_next();
            return val;
        }
    }
}

public class list<T> -> {
    private -> {
        Option<mutRef<node<T>>> head = None;
        Option<mutRef<node<T>>> current = None;
        usize length = 0;
    }
    public -> {
      fn set_head(node_ptr: Option<mutRef<node<T>>>) -> void {
        if (this.head.is_Some()) {
            del this.head;
        }
        this.head = node_ptr;
        this.length = this.length + 1;
      }
      fn get_head() -> Option<mutRef<node<T>>> {
        return this.head;
      }
      fn push(item: T) -> void {
        match (this.head) -> {
          None => {
            mutRef<node<T>> new_node = new node<T>(item);
            this.head = Some(new_node);
            this.length = this.length + 1;
          }
          Some(h) => {
            mutRef<node<T>> new_node = new node<T>(item);
            new_node.set_next(Some(h));
            this.head = Some(new_node);
            this.length = this.length + 1;
          }
        }
      }
      fn pop() -> Option<T> {
        match (this.head) -> {
          Some(h) => {
            mutRef<node<T>> temp = h;
            this.head = temp.get_next();
            T val = temp.get_value();
            del temp;
            this.length = this.length - 1;
            return Some(val);
          }
          None => {
            return None;
          }
        }
      }

      fn extend_from_array(arr: T[]) -> void {
        for (usize i = 0; i < arr.len; i = i + 1) -> {
          this.push(arr[i]);
        }
      }
      fn sort(compare: lambda<(T, T) -> int32>) -> void {
        match (this.head) -> {
          Some(h) => {
            mutRef<node<T>> temp = h;
            while (temp.get_next().is_Some()) -> {
              mutRef<node<T>> next = temp.get_next().get();
              int32 cmp = compare(temp.get_value(), next.get_value());
              if (cmp > 0) {
                temp.set_next(Some(next));
                next.set_next(Some(temp));
                temp = next;
              }
              else {
                temp = temp.get_next().get();
              }
            }
          },
          None => {}
        }
      }
      fn contains(item: T) -> bool {
        match (this.head) -> {
          Some(h) => {
            mutRef<node<T>> temp = h;
            while (temp.get_next().is_Some()) -> {
              temp = temp.get_next().get();
              if (temp.get_value() == item) {
                return true;
              }
            }
            return false;
          }
          None => {
            return false;
          }
        }
      }
      fn remove_first(item: T) -> bool {
        bool found = false;
        match (this.head) -> {
          Some(h) => {
            if (h.get_value() == item) {
              this.pop();
              return true;
            }
            mutRef<node<T>> prev = h;
            while (prev.get_next().is_Some()) -> {
              mutRef<node<T>> curr = prev.get_next().get();
              if (curr.get_value() == item) {
                found = true;
                prev.set_next(curr.get_next());
                break;
              }
              prev = curr;
            }
          },
          None => {}
        }
        if (found) {
          this.length = this.length - 1;
        }
        return found;
      }
      fn size() -> usize {
        return this.length;
      }
      fn as_array() -> T[] {
        T arr[] = new T[this.length];
        for (usize i = 0; i < this.length; i++) -> {
          arr[i] = this.pop().get();
        }
        return arr;
      }
      fn as_str() -> str {
        str result = "[";
        match (this.head) -> {
          Some(h) => {
            mutRef<node<T>> temp = h;
            result = result + temp.get_value().as_str();
            this.current = temp.get_next();
            while (this.current.is_Some()) -> {
              temp = this.current.get();
              result = result + ", " + temp.get_value().as_str();
              this.current = temp.get_next();
            }
          }
          None => {}
        }
        result = result + "]";
        return result;
      }
    }
    handle -> {
      fn index_access(index: usize) -> Option<mutRef<T>> {
           this.current = this.head;
          for (usize i = 0; i < index; i = i + 1) -> {
           this.current = this.current.get_next();
          }
          if (this.current.is_None()) {
            return None;
          }
          return this.current;
      }
      fn arrow(arr: T[]) -> void {
        this.extend_from_array(arr);
      }
      fn arrow_assign(arr: T[]) -> void {
        this.extend_from_array(arr);
      }
      fn iter() -> list_iter<T> {
        list_iter<T> it;
        it.current = this.head;
        return it;
      }
      fn drop() -> void {
          del this.head;
          if(this.current.is_Some()){
            del this.current;
          }
      }
      fn display() -> char[] {
          return this.as_str();
      }
    }
    constructor -> {
      init() -> {
        this.head = None;
        this.current = None;
        this.length = 0;
      }
      init(arr: T[]) -> {
        this.head = None;
        this.current = None;
        this.length = 0;
        this.extend_from_array(arr);
      }
    }
}

public class HashSet<T> -> {
    private {
        list<T> items;
    }
    public {
        fn add(item : T) -> void {
            if (this.items.contains(item)) {
                return;
            }
            this.items.push(item);
        }
        fn remove(item : T) -> void {
            this.items.remove_first(item);
        }
        fn contains(item : T) -> bool {
            return this.items.contains(item);
        }
        fn size() -> usize {
            return this.items.size();
        }
        fn as_array() -> T[] {
            return this.items.as_array();
        }
    }
    constructor {
        init() -> {
        }
        init(arr: T[]) -> {
            for (usize i = 0; i < arr.len; i = i + 1) -> {
                this.add(arr[i]);
            }
        }
    }
    handle {
        fn drop() -> void {
            del this.items;
        }
        fn index_access(index: usize) -> T {
            return this.items[index];
        }
        fn arrow(arr: T[]) -> void {
            for (usize i = 0; i < arr.len; i = i + 1) -> {
                this.add(arr[i]);
            }
        }
        fn arrow_assign(arr: T[]) -> void {
            for (usize i = 0; i < arr.len; i = i + 1) -> {
                this.add(arr[i]);
            }
        }
        fn display() -> char[] {
            return this.items-.display();
        }
    }
}

public class KeyValuePair<K, V> -> {
    public -> {
        K key;
        V value;
        fn get_key() -> K {
            return this.key;
        }
        fn get_value() -> V {
            return this.value;
        }
        fn set_value(v: V) -> void {
            this.value = v;
        }
        fn as_str() -> str {
            return "{ key: " + this.key.as_str() + ", value: " + this.value.as_str() + " }";
        }
    }
    constructor -> {
        init(k: K, v: V) -> {
            this.key = k;
            this.value = v;
        }
    }
    handle -> {
        fn display() -> char[] {
            return this.as_str();
        }
    }
}

public class HashMap<K, V> -> {
    private -> {
        list<KeyValuePair<K, V>> entries;
        usize count = 0;
    }
    public -> {
        fn insert(key: K, value: V) -> void {
            match (this.entries.get_head()) -> {
                Some(h) => {
                    mutRef<node<KeyValuePair<K, V>>> temp = h;
                    KeyValuePair<K, V> kv = temp.get_value();
                    if (kv.get_key() == key) {
                        kv.set_value(value);
                        temp.set_value(kv);
                        return;
                    }
                    while (temp.get_next().is_Some()) -> {
                        temp = temp.get_next().get();
                        KeyValuePair<K, V> item = temp.get_value();
                        if (item.get_key() == key) {
                            item.set_value(value);
                            temp.set_value(item);
                            return;
                        }
                    }
                }
                None => {}
            }
            KeyValuePair<K, V> kv;
            kv.key = key;
            kv.value = value;
            this.entries.push(kv);
            this.count = this.count + 1;
        }

        fn get(key: K) -> Option<V> {
            match (this.entries.get_head()) -> {
                Some(h) => {
                    mutRef<node<KeyValuePair<K, V>>> temp = h;
                    KeyValuePair<K, V> kv = temp.get_value();
                    if (kv.get_key() == key) {
                        return Some(kv.get_value());
                    }
                    while (temp.get_next().is_Some()) -> {
                        temp = temp.get_next().get();
                        KeyValuePair<K, V> item = temp.get_value();
                        if (item.get_key() == key) {
                            return Some(item.get_value());
                        }
                    }
                    return None;
                }
                None => {
                    return None;
                }
            }
        }

        fn contains_key(key: K) -> bool {
            match (this.get(key)) -> {
                Some(_) => {
                    return true;
                }
                None => {
                    return false;
                }
            }
        }

        fn remove(key: K) -> bool {
            match (this.entries.get_head()) -> {
                Some(h) => {
                    mutRef<node<KeyValuePair<K, V>>> temp = h;
                    KeyValuePair<K, V> kv = temp.get_value();
                    if (kv.get_key() == key) {
                        this.entries.pop();
                        this.count = this.count - 1;
                        return true;
                    }
                    mutRef<node<KeyValuePair<K, V>>> prev = h;
                    while (prev.get_next().is_Some()) -> {
                        mutRef<node<KeyValuePair<K, V>>> curr = prev.get_next().get();
                        KeyValuePair<K, V> curr_kv = curr.get_value();
                        if (curr_kv.get_key() == key) {
                            prev.set_next(curr.get_next());
                            this.count = this.count - 1;
                            return true;
                        }
                        prev = curr;
                    }
                    return false;
                }
                None => {
                    return false;
                }
            }
        }

        fn size() -> usize {
            return this.count;
        }

        fn is_empty() -> bool {
            return this.count == 0;
        }
    }
    constructor -> {
        init() -> {
            this.count = 0;
        }
    }
    handle -> {
        fn drop() -> void {
            del this.entries;
        }
        fn index_access(key: K) -> Option<V> {
            return this.get(key);
        }
    }
}