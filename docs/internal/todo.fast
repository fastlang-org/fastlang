fn inspect_value<T>(val: T) -> void {
    // 1. فحص هل هو مؤشر
    if (typeof(val).is_pointer) -> {
        println("Value is a pointer address");
    }

    // 2. فحص هل هو مصفوفة
    if (typeof(val).is_array) -> {
        println("Value is an array of length: ", val.len);
    }

    // 3. مقارنة نوع صريحة
    if (typeof(val) == type<str>) -> {
        println("Value is a string");
    }
}
inspect_value(10);
fn safe_print<T>(val: T) -> void {
    // إذا كان النوع لا يدعم الطباعة، نرفض ترجمة البرنامج فوراً!
    if (!typeof(val).printable) -> {
        @compile::throw new Error("safe_print error: Type does not implement display handle!");
    }

    println(val);
}
safe_print(10);
@compile -> {
    // دالة تحقق هندسية بحتة وقت الترجمة
    fn assert_word_size(t : type) -> void {
        if (sizeof(t) > 8) -> {
            @compile::throw new Error("Type size exceeds 64-bit register word!");
        }
    }

    // ماكرو أو دالة لفحص السلامة
    fn verify_buffer_capacity(int32 capacity) -> void {
        if (capacity <= 0 || capacity > 4096) -> {
            @compile::throw new Error("Invalid static buffer capacity!");
        }
    }
}

