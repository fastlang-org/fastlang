enum Result<T> {
    Ok(T),
    Err {
        char[] msg;
        int32 code;
    },
}
impl handle for Result::Err {
    fn call(code: int32) -> Result::Err {
        return Result::Err {
            msg = "error",
            code = code,
        };
    }
    fn call(msg: char[]) -> Result::Err {
        return Result::Err {
            msg = msg,
            code = 0,
        };
    }
    fn call(msg: char[], code: int32) -> Result::Err {
        return Result::Err {
            msg = msg,
            code = code,
        };
    }
    fn call(fnc: function<()-> char[]>) -> Result::Err {
        return Result::Err {
            msg = fnc(),
            code = 0,
        };
    }   
}
impl Result {
    fn is_Ok() -> bool {
        match this {
            Ok(_) => return true,
            Err{_,_} => return false,
        }
        return false;
    }
    fn is_Err() -> bool {
        match this {
            Ok(_) => return false,
            Err{_,_} => return true,
        }
        return true;
    }
    fn get() -> T {
        match this {
            Ok(val) => {
                return val;
            }
            Err{msg,code} => {
                throw new Error(msg , code);
            }
        }
    }
}
// how to use it
fn i_do_something(state : int32) -> Result<int32> {
 match state {
     10 => {
        return Ok(10);
     }
     20 => {
        return Err("error");
     }
     30 => {
        return Err("error" , 100);
     }
     40 => {
        return Err(|| "error");
     }
     50 => {
        return Err(100);
     }
     _ => {
        method make_error() -> char[] {
            return "error";
        }
        return Err(make_error);
     }
 }
}

