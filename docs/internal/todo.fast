// the property_access handle 
blueprint i_pass_to_inner<T> -> {
    raw_ptr<T> ptr = undefined;
}
impl i_pass_to_inner<T> -> {
    handle -> {
        fn arrow_assign(other: raw_ptr<T>) -> {
            this.ptr = other;
        }
        fn copy() -> T {
            return *this.ptr;
        }
        fn call<...U>(...args: U) -> unknown {
            return (*this.ptr)(...args);
        }
        fn property_access(prop_type: type) -> unknown {
            return @compile::property_access( this.ptr , prop_type);
        }
        fn deref() -> T {
            return *this.ptr;
        }
    }
}
// to use it
i_pass_to_inner<int32> i  -> new int(10);
i.as_str(); // "10"  // the type of as_str will be function::as_str<unknown>
i-.property_access(fn::as_str<()-> str>); // "10"
(*i).as_str(); // "10"
(i-.deref()).as_str(); // "10"
i_pass_to_inner<lambda<(int32) -> int32>> i2 -> |x: int32| x + 10;
i2-.call(10); // 20
i2(10); // 20
(*i2)(10); // 20
(i2-.deref())(10); // 20

// =========================================================================
// Specification & Standard Conventions: as_str vs display
// =========================================================================
// 1. as_str() Handle:
//    - Purpose: Programmatic string serialization and lossless conversion.
//    - Usage: Used for data interchange, serialization, code generation,
//      and machine-readable representations (e.g. JSON, exact numeric strings).
//    - Priority: Called when .as_str() is requested or for programmatic
//      string coercion.
//
// 2. display() Handle:
//    - Purpose: Human-facing formatted presentation and pretty printing.
//    - Usage: Used by print, println, logger output, debugging inspectors,
//      and user-facing UIs. Can include visual wrappers, brackets, colors, etc.
//    - Default Fallback: If a type defines display(), print prioritizes it.
//      If display() is not defined, it falls back to as_str().
// =========================================================================

//  compile blocks 
// 1
fn i_have_many_branches_depend_on_runtime<T>(n : T) -> void {
    if(typeof(n).is_pointer()){
        println("Pointer");
    }else if(typeof(n).is_array()){
        println("Array");
    }else if(typeof(n).is_primitive()){
        println("Primitive");
    }else if(typeof(n).is_constant()){
        println("Constant");
    }else {
        println("Unknown");
    }
}
// what it will look like after running the interpreter
fn i_have_many_branches_depend_on_runtime_br1<T>(n : T) -> void {
    println("Pointer");
}
fn i_have_many_branches_depend_on_runtime_br2<T>(n : T) -> void {
    println("Array");
}
fn i_have_many_branches_depend_on_runtime_br3<T>(n : T) -> void {
    println("Primitive");
}
fn i_have_many_branches_depend_on_runtime_br4<T>(n : T) -> void {
    println("Constant");
}
fn i_have_many_branches_depend_on_runtime_br5<T>(n : T) -> void {
    println("Unknown");
}
// if i call the fn it will check and run the original and see what is the needed branch
i_have_many_branches_depend_on_runtime(10);
// it is branch 3
i_have_many_branches_depend_on_runtime_br3(10);
