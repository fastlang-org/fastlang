 };
)&if[
   set this as keyword::if;
   set override = true; // to set the override the if scope 
    ][
  set  this.type = condition;
  set this as con;
]{
 set inner {scope} if(con);
 set handle += {
    fn error(e) -> void { //todo: same as catch 
       println(e +" this happened in if ")
    }
 }
}&else if(&if){
    &_gh(&_gh[counter] + 1);
}else{
 set inner {scope} if(!con);
 set handle += {
    fn error(e) -> void { //todo: same as catch 
       println(e +" this happened in if ")
    }
 }
}
