// for making alias objects
set str == char[];
struct Dog {
    str name;
    int32 age;
};
struct Cat {
    str name;
    int32 age;
};
set Dog == Cat;
// Cat and Dog have the same fields then they are equal in (fields) and (fields only)
// that will allow us to impl for a one type of them and will be added to the other
// that will allow us to impl the Cat and Dog in the same block
impl Cat, Dog {
    fn print() -> void {
        println(this.name, " is ", this.age, " years old");
    }
};
Cat c = Cat {
    name = "cat";
    age = 10;
};
Dog d = Dog {
    name = "dog";
    age = 10;
};
c.print(); // cat is 10 years old
d.print(); // dog is 10 years old
