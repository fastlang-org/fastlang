// new machine support
machine<int32> counter {
    set start {
        //set runOnce = true;
        local := 10;
        this {
            count := 0;
        }
        goto step;
    }[1];
    set step  {
        count = count + 1;
        if (count >= max_limit) {
            goto finish;
        }
        this {
            count = count + 1;
        }
        goto step;
    }[max_limit + 1];
    set finish {
        leave;
    }[];
    handle -> {
        fn call() -> int32 {
            goto start;
        }
        fn leave() -> int32 {
            return this.count;
        }
    }
}
