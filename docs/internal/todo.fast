// the macro new support
// first it will be two parts a one for the syntax and the other for the code it self it will run
// macro name <synax block>  -> {inner code block}
// for supporting generics it will be <T> then () a params block 
// also the {} block can be micro block (inserted)
// [] mean a no () or {} or [] 
// to get [] you need to write [[]]
// &_ means ghost
// & before new to use it in the syntax 
macro &_ &new<T>[
    in {
        T x;
    }
] ->  // we can here add a return type
{
    set override = true; // to allow us override the existing syntax for the used keywords (new)
    set in as {micro}; // we can set any time through as , this line mean this scope will be run like a micro mean by that it will be inserted in compile time
    public in {   // we can have a public block that will run very time we call the macro
        new x;
    };  
    private in { 
        @compile::print(x);
    }; 
}
int* x = new int(10); // will print 10 in compile time
macro &_
&&{
//&& for block that will declare some needed vars before the syntax block
     set bl as {[(fn , fn)]};
     enum Sc {
         If,
         Else,
     }
     set count := 0;
}&&while(true){
     &&bl{[count]=(
    &if[
    set in as {condition};
    in {
        bool con;
    };
] {
    set in as {fn};
    &&{
        set sc as {Sc::If};
    }
}
),
(&else &&{
    if(&if){
        &&count += 1;
        continue;
    }
}
{
    set in as {fn};
    &&{
        set sc as {Sc::Else};
        break;
    }
}
)}
} -> auto {
   for f in bl {
       if (f[0].sc == Sc::If && f[0].con) {
           f[0]();
       }else if(f[0].sc == Sc::Else){
           f[0]();
           break;
       }else if(f[1].sc == Sc::Else){
           f[0]();
       }else{
           continue;
       }
   }
}

