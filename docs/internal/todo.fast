@compile :: macro _ffi_scope_ &[@][name : str]#{inner : extern}->{
    match name {
        "dependency" => {
            @compile::insert_dependency(inner);
        }
        _ => {
            @compile::print("macro ffi_scope name : ",name);
            in {
                println("macro ffi_scope name : ",name);
            };
            return in {
            Document[name](DocumentPayload {
                name = "." + name,
                content = inner,
                created = Time::now(),
                updated = Time::now(),
            }); };
        }
    }
}
