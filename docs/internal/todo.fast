// the new way now
blueprint shared ->{
    T ptr = undefined;
    int owners = 0;
}
impl shared{
    fn share(other : mutRef) -> {
        if (this.ptr == other.ptr) {
            this.owners += 1;
        }
    }
    fn share(other : pointer) -> {
        if (this.ptr == other.ptr) {
            this.owners += 1;
        }
    }
}
blueprint mutRef<...T> ->{
    T* ptr = undefined;
    type inner = T;
    type expect[] = [...T];
    share shared;
}
blueprint pointer<T> ->{
    T* ptr = undefined;
    share shared;
}
