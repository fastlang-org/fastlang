// leave is for leaving the parent scope , exit for exiting the hole program 
enum Do {
    Leave,
    Exit,
}
fn i_have_leave(d : Do) -> void {
    if(d == Do::Leave){
        leave;
    }else if (d == Do::Exit) {
        exit 69; // maybe exit(69)
    }
}

