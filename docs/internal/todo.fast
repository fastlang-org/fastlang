// that is the def of the ref and mutRef
// ref 
/*
  ptr : *T
  inner : type
  expect : array<type>
*/
// that is the fields of the ref 
// ptr : *T is the ptr to the data
// inner_type : type is the type of the data to carry
// expect_types : array<type> is the types of expected the data to carry
// as you know you can define a ref like this
 ref<int32,char> ref_in;
 int32 val = 10;
 ref_in =  val;
 println(ref_in.inner); // EXPECT: int32
 println(ref_in.expect); // EXPECT: [ int32, char ]
 char ch = 'a';
 ref_in = ch; // error : ref_in (type ref<int32,char>) only can be assigned to a ref<int32> or a ref<char> 
 // that mean that the ref_in can only be assigned to a single type from the expect_types
// and after that it will only carry that type

// mutRef
/*
  ptr : *T
  owners : int32 
  inner : type
  expect : array<type>
  share{ owners }if(this.ptr == other.ptr);
*/
// to delete a mutRef inner val you need to call the drop handle and to be the last owner
// so we need to create a way to make a easy RC method (share) also i thick we can add more
// who to define it in the lang
blueprint mutRef<...T> = {
  T* ptr = undefined;
  type inner = T;
  type expect[] = [...T];
  share{
    int32 owners = 0;
  }if(this.ptr == other.ptr);
}
// also we will add handle called share it will the a mut ref for the fields in the share block
impl mutRef<...T> {
    handle {
        // we may add a handle for equal_assign
        fn arrow_assign(other: ref) -> {
            @compile {
                 if(!this.expect.contains(other.inner)){
                    throw new Error("can not assign a different type of ref");
                 }
            }(this, other);
            this.ptr = other.ptr;
        }
        fn arrow_assign(other: mutRef<...T>) -> {
            @compile {
                 if(!this.expect.contains(other.inner)){
                    throw new Error("can not assign a different type of ref");
                 }
            }(this, other);
            this.ptr = other.ptr;
        }
        fn share() -> void {
            share.owners += 1;
        }
        fn PartialEqual(mutRef<...T> other) -> bool {
            return this.ptr == other.ptr;
        }
        fn drop() -> void {
            this.owners -= 1;
            if (this.owners == 0) {
                del this.ptr;
            }
        }
    }
}
