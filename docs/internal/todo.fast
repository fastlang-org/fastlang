    };
){
    set inner {scope} if(con){
        println("if");
    };
    set return as ret = auto;
    set super as sp = function; //it will run inner like a fn
}{
    set inner {scope} if(!con){
        println("else");
    };
    set return = ret;
    set super = sp;
};
int x = 10;
makeup_if(x == 10){
    println("x = 10");
}{
    println("unr");
} // that will print "if\n" then "x = 10\n"
makeup_if(x > 15){
    println("unr");
}{
    println("x > 15");
} // that will print "else\n" then "x > 15\n"

