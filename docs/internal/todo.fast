        scope;
    }
    println("macro ffi_scope name : ",ffi);
}
x := @html [10];
// ->
{
    println("macro ffi_scope name : ","html");
}();
x := 10;
{
    println("macro ffi_scope name : ","html");
}();
macro _x_ @[ffi:str]&[::][[
    scope : expr
]] -> {

    in {
    println("macro ffi_scope name : ",ffi);
    }
    return in {
        scope;
    }
    in {
    println("macro ffi_scope name : ",ffi);
    }
}
x := @html [10];
// ->

println("macro ffi_scope name : ","html");
x := 10;
println("macro ffi_scope name : ","html");
// any opretion happen outside the in inject block must be at compile time
macro _x_ @[ffi:str]&[::][[
    scope : expr
]] -> {
    ffi = "." + ffi;
    in {
    println("macro ffi_scope name : ",ffi);
    }
    return in {
        scope;
    }
    in {
    println("macro ffi_scope name : ",ffi);
    }
}
x := @html [10];
// ->

println("macro ffi_scope name : ",".html");
x := 10;
println("macro ffi_scope name : ",".html");
macro _x_ @[ffi:str]&[::][[
    scope : int32
]] -> {
    ffi = "." + ffi;
    println("macro ffi_scope name : ",ffi);
    return scope;
}
x := @html [10];
// ->
fn x_macro(ffi : str , scope : int32) -> {
    ffi = "." + ffi;
    println("macro ffi_scope name : ",ffi);
    return scope;
}
x := x_macro("html",10);

@compile :: macro _x_ @[ffi:str]&[::][[
    scope : int32
]] -> {
    ffi = "." + ffi;
    @compile::print("macro ffi_scope name : ",ffi);
    return scope;
}
