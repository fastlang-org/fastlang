    }
}
// in this case we will generate normally the all branches even if we have a compile time branch
// and if we call the fn that will be checked at compile time if we counter the compile time branch we will call the compile time branch for it
// and if we counter the runtime branch we will run it at runtime
// but we will still have the same order of the branches
