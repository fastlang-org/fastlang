// new timer
struct Timer {
    private {
    Time start;
    Time update;
    Time taken;
    }
    static {
        fn now() -> Time {
            return Time::now();
        }
        fn new() -> Timer {
            return Timer {
                start = Time::now(),
                update = Time::now(),
                taken = Time {
                    days = 0,
                    hours = 0,
                    minutes = 0,
                    seconds = 0,
                    milliseconds = 0,
                },
            };
        }
    }
    public {
        fn reset() -> void {
            this.start = Time::now();
            this.update = Time::now();
        }
        fn update() -> void {
            this.update = Time::now();
        }
        fn taken() -> Time {
            this.taken = Time::now() - this.start;
            return this.taken;
        }

    }
}
timer := Timer::new();
timer.reset();
timer.update();
println(timer.taken());


