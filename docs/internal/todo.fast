// @sys
@sys :: {
    set alloc(usize) -> auto;
    set free(auto) -> void;
    set write(auto, usize) -> void;
    set read(auto, usize) -> void;
    set print(auto) -> void;
    set println(auto) -> void;
}
// new @compile method to now the backend
enum Backend {
    Cpp,
    Cranelift,
}
enum System {
    Linux,
    Windows,
    MacOS,
}
@compile :: {
    set backend() -> Backend;
    // we may add a way to new the system
    set system() -> System;
}
// remove old syntax @compile -> {}
extern @c :: {
    fn fast_alloc(usize) -> auto;
    fn fast_free(auto) -> void;
    fn fast_write(auto, usize) -> void;
    fn fast_read(auto, usize) -> void;
    fn fast_print(auto) -> void;
    fn fast_println(auto) -> void;
}
method alloc(s : usize) -> auto {
    if(@compile::backend() == Backend::Cpp) {
        return @c::fast_alloc(s);
    }else if(@compile::backend() == Backend::Cranelift) {
        return @sys::alloc(s);
    }
}

