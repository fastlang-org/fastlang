// we have a problem when we have a extern struct decl it may cuase some problems
// when we have a struct with the same name
// to explan further :
/*
// fast_window test using raylib 5.0 (C ABI)
import @c "raylib.h";
import std::fmt;
struct Rectangle {
         int x;
         int y;
         int width;
         int height;
}
extern @c  "raylib.h" ::  {
    struct Color {
         int r;
         int g;
         int b;
         int a;
    }
    fn DrawRectangleRec(rec: Rectangle, color: Color);
}
*/
/*
PS C:\Users\DELL\projects\fast_window> C:\Users\DELL\projects\fast_lang\target\debug\fast_lang.exe run 
Compiling C:\Users\DELL\projects\fast_window\src/main.fast...
Including external library <raylib.h> (ABI: @C)...
C:\Users\DELL\projects\fast_window\build\fast_window.cpp:16:8: error: redefinition of 'struct Rectangle'
   16 | struct Rectangle {
      |        ^~~~~~~~~
In file included from C:\Users\DELL\projects\fast_window\build\fast_window.cpp:4:
C:\Users\DELL\projects\fast_window\packages\raylib/raylib.h:244:16: note: previous definition of 'struct Rectangle'
  244 | typedef struct Rectangle {
      |                ^~~~~~~~~
C++ compilation failed! Check C:\Users\DELL\projects\fast_window\build\fast_window.cpp for errors.
*/
// so this is the problem
// when we try to use an existing struct as a param for an extern fn we will get an error
// because the compiler will make a new struct with the same name
// so we need to make the compiler to use the existing struct in the extern lib
// and also we will allow impl on extern struct or struct used in extern fn
// we also will add a way to make a similar structs
// i mean if we have a two or more struct with the same fields
// we will add a way to make a similar struct (with the same type)
// maybe that will be in the declaration of the struct
// ex :
struct Rectangle {
         int x;
         int y;
         int width;
         int height;
} as @c"raylib.h"::Rectangle; // in this way we will make the compiler to use the raylib.h::Rectangle
//! also this problem it more about how we translate modules 
// @c"raylib.h" , is not existing syntax but we will add it
// we may remove the need of :
import @c "raylib.h";
// so now you can declare whare the extern from
extern @c "raylib.h" ::  {}
// so there is no need to import it
// but if you import it
// you will can use @c"raylib.h"::
// but we may allow to use @c"raylib.h"::
// without the need to import it or declare it in the extern block
// but you will need to use the new syntax struct Rectangle {...} as @c"raylib.h"::Rectangle;
// for fn we will allow to use the new syntax , but maybe hard



