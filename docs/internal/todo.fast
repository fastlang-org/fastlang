// i think we can make unique type by the share feature
blueprint Id {
    int32 counter = 0;
} 
impl handle for id {
    fn share() -> void {
        this.counter = this.counter + 1;
    }
}
blueprint unique<T> -> {
    raw_ptr<T> ptr = undefined;
    raw_ptr<Id> id_counter = undefined;
    int32 id = 0;
    type inner = T;
    share id_counter if (this.ptr != other.ptr && this.inner == other.inner){
        this.id = id_counter.counter;
    };
}
